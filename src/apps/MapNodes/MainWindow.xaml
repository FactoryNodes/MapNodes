<Window x:Class="MapNodes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MapNodes"
        xmlns:p="clr-namespace:FactoryNodes.MapNodes.Presentation;assembly=FactoryNodes.MapNodes.Presentation"
        Title="{Binding Title}" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        Icon="Assets/mapnodes.ico" Background="{StaticResource PaperBrush}" AllowDrop="True">

    <!-- La ventana de MapNodes (DataContext = MapNodesViewModel): arriba los botones del fichero; a la izquierda la cabecera y el protocolo; en
         el centro, en pestañas, los parámetros, los grupos y las órdenes; abajo lo que no vale y la línea de estado. Solo pinta y reenvía. -->

    <DockPanel>
        <!-- ======================================== Barra de arriba ======================================== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/mapnodes.ico" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="MapNodes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding NewCommand}" ToolTip="{l:T 'Nuevo: un fichero de dispositivo vacío'}">
                        <Image Source="{Binding Source={x:Static p:MapNodesIcons.New}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenCommand}" ToolTip="{l:T 'Abrir…: un fichero de dispositivo (.json); también se puede arrastrar a la ventana'}">
                        <Image Source="{Binding Source={x:Static p:MapNodesIcons.Open}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource PrimaryIconButton}" Command="{Binding SaveCommand}" ToolTip="{l:T 'Guardar (Ctrl+S): en su fichero; la primera vez, como marca/modelo.json'}">
                        <Image Source="{Binding Source={x:Static p:MapNodesIcons.Save}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding SaveAsCommand}" ToolTip="{l:T 'Guardar como…: en otro fichero'}">
                        <Image Source="{Binding Source={x:Static p:MapNodesIcons.SaveAs}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="LanguageButton" Style="{StaticResource IconButton}" Margin="0" Click="OnLanguageClick"
                        ToolTip="{l:T 'Idioma del programa (se vuelve a abrir)'}">
                    <Image Source="{Binding Source={x:Static p:MapNodesIcons.Language}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Languages}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                    <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="{l:T 'El mapa de un dispositivo: sus parámetros con su dirección Modbus o EtherNet/IP, como lo leen FactoryNodes y la Factory Box.'}"
                           Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
            </DockPanel>
        </Border>

        <!-- ======================================== Abajo: estado ======================================== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource GrayBrush}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ======================================== Abajo: lo que no vale ======================================== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ProblemsHeader}" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding Problems}" MaxHeight="110" BorderThickness="0" Foreground="{StaticResource RedBrush}" Margin="0,2,0,0"
                         Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="{l:T 'Lo mismo que comprueba el programa al leer el fichero: con algún problema, no lo carga.'}" />
            </DockPanel>
        </Border>

        <!-- ======================================== Izquierda: cabecera y protocolo ======================================== -->
        <Border DockPanel.Dock="Left" Width="330" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,4,14,14">
                    <TextBlock Text="{l:T 'Cabecera'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T 'Marca'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Brand, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'El fabricante, como lo escribe él (es la carpeta del fichero, en minúsculas)'}" />
                    <TextBlock Text="{l:T 'Modelo'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ModelName, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'El modelo (es el nombre del fichero). Marca y modelo juntos identifican el dispositivo en los proyectos y en las copias.'}" />
                    <TextBlock Text="{l:T 'Tipo de equipo'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Kind, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'Variador, visor de peso, arrancador…'}" />
                    <TextBlock Text="{l:T 'Descripción'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" />
                    <TextBlock Text="{l:T 'De dónde salen las direcciones'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Source, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"
                             ToolTip="{l:T 'El manual y la página (o la herramienta), para que otro pueda comprobarlo'}" />
                    <CheckBox Content="{l:T 'Probado con un equipo real'}" IsChecked="{Binding Verified}" Margin="0,10,0,0"
                              ToolTip="{l:T 'Solo si se han leído las direcciones en un equipo de verdad. Sin marcar, el programa avisa antes de restaurar una copia.'}" />
                    <TextBlock Text="{l:T 'Lleva el dibujo del equipo (se conserva al guardar).'}" Foreground="{StaticResource GrayBrush}" FontSize="11" Margin="0,6,0,0"
                               Visibility="{Binding HasDrawing, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{l:T 'Protocolo'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T 'Numeración de los registros'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding RegisterBases}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding RegisterBase}"
                              ToolTip="{l:T 'Si el manual cuenta los registros desde 1, en la trama va la dirección menos 1'}" />
                    <TextBlock Text="{l:T 'Valores de 32 bits'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding WordOrders}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding WordOrder}"
                              ToolTip="{l:T 'En qué orden van las dos palabras de un UDINT, DINT o REAL'}" />
                    <TextBlock Text="{l:T 'Registros por lectura (1 a 125)'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MaxRegistersPerRead, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left"
                             ToolTip="{l:T 'Cuántos registros seguidos acepta el equipo en una lectura'}" />
                    <TextBlock Text="{l:T 'Guardar en EEPROM tras escribir (vacío: lo guarda solo)'}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SaveAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"
                                 ToolTip="{l:T 'La dirección donde se escribe la orden de guardar, como en el manual (0x0900)'}" />
                        <TextBox Grid.Column="1" Text="{Binding SaveValue, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'El valor que se escribe para guardar'}" />
                    </Grid>
                    <TextBox Text="{Binding SaveDescription, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" ToolTip="{l:T 'Qué hace (Guardar en EEPROM)'}" />
                    <TextBlock Text="{l:T 'Antes de restaurar'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RestoreNotes, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"
                             ToolTip="{l:T 'Lo que hay que saber antes de escribir una copia en un equipo nuevo (parado, en qué modo…)'}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================== Centro: parámetros, grupos y órdenes ======================================== -->
        <TabControl Margin="10" Background="White">
            <TabItem Header="{Binding ParametersHeader}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource IconButton}" Command="{Binding AddParameterCommand}" ToolTip="{l:T 'Añadir un parámetro'}">
                            <Image Source="{Binding Source={x:Static p:MapNodesIcons.AddRow}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PasteParametersCommand}"
                                ToolTip="{l:T 'Pegar de una hoja de cálculo: código, dirección, tipo, escala, unidad, descripción, grupo, clase (ajuste o en vivo) y si se escribe, en columnas (o separados por punto y coma). Un código que ya está se actualiza.'}">
                            <Image Source="{Binding Source={x:Static p:MapNodesIcons.Paste}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Parameters}" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T 'Código'}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Code, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold"
                                                 ToolTip="{l:T 'El código del fabricante (F002, ACC): único en el modelo'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Dirección'}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Address, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                 ToolTip="{l:T 'La dirección Modbus como en el manual: 0x1103 o 8502. Vacía si el equipo solo habla EtherNet/IP.'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'EtherNet/IP'}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Cip, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                 ToolTip="{l:T 'Opcional: clase/instancia/atributo (0x64/1/0x08)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Tipo'}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static p:ParameterRow.Types}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="1"
                                                  ToolTip="{l:T 'UINT e INT ocupan un registro; UDINT, DINT y REAL, dos'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Escala'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Scale, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T 'Valor = registro × escala (0,01: centésimas)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Unidad'}" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Unit, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Descripción'}" Width="2*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Grupo'}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding GroupOptions}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding Group}" Margin="1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Básico'}" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Basic, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{l:T 'Sale el primero, en «Básicos»'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Clase'}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static p:ParameterRow.Kinds}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding Kind}" Margin="1"
                                                  ToolTip="{l:T 'Ajuste: se guarda en las copias y se restaura. En vivo: solo se lee (velocidad, intensidad, peso).'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Escribe'}" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Writable, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{l:T 'Se puede escribir (restaurar). Sin marcar, se guarda pero no se escribe (versión, capacidad).'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Calibración'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Calibration, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{l:T 'Es de la calibración de este equipo (básculas): al restaurar una copia llega sin marcar'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Opciones'}" Width="1.4*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Options, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T 'El texto de cada valor: 0=Adelante; 1=Atrás'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Bits'}" Width="1.2*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Bits, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T 'En una palabra de estado, qué es cada bit: 0=Listo; 3=Fallo'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Nota'}" Width="1.4*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T 'Rango, valor de fábrica, unidad que depende de otro parámetro…'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="2" BorderThickness="0" Content="×" FontSize="14" Margin="0" Background="Transparent"
                                                Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{l:T 'Quitar el parámetro'}" ToolTip="{l:T 'Quitar el parámetro'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding GroupsHeader}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource IconButton}" Command="{Binding AddGroupCommand}" ToolTip="{l:T 'Añadir un grupo'}">
                            <Image Source="{Binding Source={x:Static p:MapNodesIcons.AddRow}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <TextBlock Text="{l:T 'Los grupos ordenan el listado de parámetros (Datos del motor, Rampas…); el número es el orden.'}" Foreground="{StaticResource GrayBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Groups}" MaxWidth="700" HorizontalAlignment="Left">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T 'Número'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Number, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Texto'}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="2" BorderThickness="0" Content="×" FontSize="14" Margin="0" Background="Transparent"
                                                Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{l:T 'Quitar el grupo'}" ToolTip="{l:T 'Quitar el grupo'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding CommandsHeader}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource IconButton}" Command="{Binding AddCommandCommand}" ToolTip="{l:T 'Añadir una orden'}">
                            <Image Source="{Binding Source={x:Static p:MapNodesIcons.AddRow}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <TextBlock Text="{l:T 'Las órdenes del equipo como botones (cero, tara, borrar el pico): un valor que se escribe en una dirección.'}"
                                   Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Commands}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T 'Texto'}" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'El texto del botón (Tara)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Dirección'}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Address, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Valor'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Antes, 0'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ClearFirst, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{l:T 'Escribir 0 antes del valor (algunos equipos solo ven el cambio)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Confirmar'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Confirm, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="{l:T 'Pedir confirmación antes (lo que mueve algo o cambia la calibración)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Respuesta en'}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding ResponseAddress, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                 ToolTip="{l:T 'Dónde contesta el equipo (vacío: no se espera respuesta)'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Hecha'}" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding ResponseDone, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding HasResponse}"
                                                 ToolTip="{l:T 'El valor de la respuesta que dice «hecha»'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Error'}" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding ResponseError, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding HasResponse}"
                                                 ToolTip="{l:T 'El valor de la respuesta que dice «error»'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T 'Nota'}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Text="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="2" BorderThickness="0" Content="×" FontSize="14" Margin="0" Background="Transparent"
                                                Command="{Binding DataContext.RemoveCommandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{l:T 'Quitar la orden'}" ToolTip="{l:T 'Quitar la orden'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
